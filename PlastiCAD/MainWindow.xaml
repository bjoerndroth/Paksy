<Window x:Class="PlastiCAD.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PlastiCAD"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
   

   
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>

                <!-- Linke Teileliste -->
        <ListBox x:Name="PartsList"
         Grid.Column="0"
         Margin="5"
         SelectionChanged="PartsList_SelectionChanged"/>

        <!-- Baufläche -->
        <TabControl Grid.Column="1"
            Margin="5">

            <!-- Paksy Plan -->
            <TabItem Header="Paksy Plan">
                <Canvas x:Name="BuildArea"
                Focusable="True"
                Background="WhiteSmoke"
                MouseLeftButtonDown="BuildArea_MouseLeftButtonDown"
                MouseMove="BuildArea_MouseMove"
                MouseLeftButtonUp="BuildArea_MouseLeftButtonUp"/>
            </TabItem>

            <!-- Paksy World -->
            <TabItem Header="Paksy World">
                <Border Background="LightGray">
                    <Viewport3D x:Name="WorldViewport"
                                MouseWheel="WorldViewport_MouseWheel">

                        <!-- Kamera -->
                        <Viewport3D.Camera>
                            <PerspectiveCamera 
                                x:Name="WorldCamera"
                                Position="3,3,5"
                           LookDirection="-3,-3,-5"
                           UpDirection="0,1,0"
                           FieldOfView="60"/>
                        </Viewport3D.Camera>

                        <!-- Licht -->
                        <ModelVisual3D>
                            <ModelVisual3D.Content>
                                <DirectionalLight Color="White"
                              Direction="-1,-1,-2"/>
                            </ModelVisual3D.Content>
                        </ModelVisual3D>

                        
                    </Viewport3D>
                </Border>
            </TabItem>

        </TabControl>

        <!-- Statusleiste -->
                <StatusBar Grid.Row="1"
                   Grid.ColumnSpan="2">
            <TextBlock x:Name="StatusText" Text="Bereit"/>
        </StatusBar>

    </Grid>
</Window>
