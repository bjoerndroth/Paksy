<Window x:Class="PlastiCAD.FullscreenAnimationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PlastiCAD"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Topmost="True"
        Background="White"
        KeyDown="Window_KeyDown"
        MouseDown="Window_MouseDown"
        MouseWheel="Window_MouseWheel"
MouseUp="Window_MouseUp"
MouseMove="Window_MouseMove"
Cursor="Arrow">

    <Grid>
        <Viewport3D x:Name="AnimationViewport">
            <Viewport3D.Camera>
                <PerspectiveCamera x:Name="AnimationCamera"
                                   FieldOfView="45"
                                   UpDirection="0,1,0"/>
            </Viewport3D.Camera>
        </Viewport3D>

        <TextBlock x:Name="HelpText"
                   Margin="24,20,0,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   FontFamily="Segoe UI"
                   FontSize="16"
                   Foreground="#DD000000"
                   IsHitTestVisible="False"
                   Text="X  Y  Z    Drehachse wechseln&#x0a;Mausrad      Zoomen&#x0a;Esc / Klick  Beenden"/>
    </Grid>
</Window>